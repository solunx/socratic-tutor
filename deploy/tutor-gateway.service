[Unit]
Description=Socratic Tutor web gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust User, paths, and port for your machine
User=YOUR_LINUX_USER
WorkingDirectory=/path/to/tutor
Environment=PATH=/path/to/tutor/.venv/bin:/usr/bin
ExecStart=/path/to/tutor/.venv/bin/python -m uvicorn gateway.app:app --host 127.0.0.1 --port 8790
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
