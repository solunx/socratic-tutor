  "asserts": [
    { "type": "intent_repeat", "text": "dat hebben we al gedaan", "expect": true },
    { "type": "intent_skip_resume", "text": "liever over iets anders", "expect": true },
    { "type": "intent_full_teach", "text": "ik snap je vraag niet, leg uit", "expect": true },
    { "type": "intent_list_subjects", "text": "welke onderwerpen heb ik?", "expect": true },
    { "type": "intent_subject_topic", "text": "ik wil verder leren over agents", "expect_contains": "agents" }
  ]
}
